# 이 파일을 .env.local 로 복사하고 값을 채운 뒤 다시 빌드하세요. (.env.local은 git에 올라가지 않습니다)
# Google Drive 백업은 보류된 기능입니다. 다시 쓰려면 true로 바꾸고 아래 클라이언트 ID도 넣으세요.
ENABLE_DRIVE_BACKUP=false
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID (유형: Chrome 확장 프로그램)
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
